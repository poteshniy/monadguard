# Copy to .env — .env is gitignored. Never commit real values.

# Alchemy Monad RPC. Only the key; server/chain.js builds
# https://monad-testnet.g.alchemy.com/v2/<key> from it.
ALCHEMY_KEY=

# Overrides ALCHEMY_KEY entirely if you need a different provider.
# RPC_URL=

# Funded Monad testnet account. Pays gas AND is the on-chain attestor address.
PRIVATE_KEY=

CHAIN_ID=10143

# Set after `npm run deploy` (or read from deployment.json automatically).
# REGISTRY_ADDRESS=

# 32 bytes standing in for the passkey PRF output. HEADLESS/CI ONLY —
# in production the browser derives this and the server never sees a key.
# Generate: openssl rand -hex 32
MONADGUARD_PRF_HEX=

# Public origin used to build receiptURI. Must be the final domain before
# the demo passkey is created — rpId is domain-bound.
BASE_URL=http://localhost:8787

# 1 = POST /scan anchors immediately instead of returning a pending anchor.
AUTO_ANCHOR=0
