{
  "name": "monadguard-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node compile.cjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "node server/index.js",
    "test": "node test/parity.test.mjs && node test/rules.test.mjs && node test/receipt.test.mjs && node scripts/attestor.test.mjs && node test/client.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "predev": "node scripts/check-secrets.mjs",
    "predeploy": "node scripts/check-secrets.mjs",
    "worker": "node server/worker.js",
    "hooks": "node scripts/check-secrets.mjs --install-hook",
    "secrets": "node scripts/check-secrets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:public": "node scripts/check-public.mjs",
    "build:web": "esbuild web/src/passkey.js --bundle --format=iife --global-name=MGPasskey --minify --target=es2022 --legal-comments=eof --outfile=web/passkey.js",
    "seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "capture": "node scripts/capture.mjs",
    "survey": "node scripts/survey.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^11.0.0",
    "canonicalize": "^2.1.0",
    "hono": "^4.13.7",
    "jose": "^5.9.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/statemanager": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "esbuild": "^0.25.12",
    "solc": "0.8.28",
    "@category-labs/mera": "0.2.0"
  }
}
